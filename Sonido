<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>D10 FOCUS ULTRA</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{
  --bg:#070910;--panel:rgba(18,21,37,.88);--line:#a18aff2b;
  --accent:#9b7bff;--accent2:#59c9ff;--green:#62f5b0;
  --text:#f4f5ff;--muted:#9296b2;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;min-height:100vh;overflow-x:hidden;transition:background .4s}
button,input,select{font:inherit}
button{cursor:pointer}
#particles{position:fixed;inset:0;width:100%;height:100%;z-index:-2;pointer-events:none}
.glow{position:fixed;width:350px;height:350px;border-radius:50%;filter:blur(110px);opacity:.17;z-index:-1;pointer-events:none;animation:float 12s infinite alternate}
.glow.one{background:var(--accent);top:-120px;left:-130px}
.glow.two{background:var(--accent2);right:-150px;top:40%;animation-delay:-4s}
.glow.three{background:#7628aa;bottom:-220px;left:25%}
@keyframes float{to{transform:translate(40px,35px) scale(1.2)}}
.app{width:min(1120px,100%);margin:auto;padding:22px 15px 45px}
header,.brand,.level-top,.heading{display:flex;align-items:center;justify-content:space-between;gap:12px}
header{margin-bottom:24px}
.brand{justify-content:flex-start}
.logo{width:47px;height:47px;display:grid;place-items:center;border-radius:15px;background:linear-gradient(135deg,var(--accent),#527dff);font-weight:900;font-size:20px;box-shadow:0 0 30px #795aff55}
.brand h1{font-size:21px;letter-spacing:3px;margin:0}
.brand p{font-size:10px;color:var(--muted);letter-spacing:1.5px;margin:4px 0 0}
.header-right{text-align:right;color:var(--muted);font-size:11px}
#clock{font-size:20px;font-weight:900;color:white;margin-bottom:4px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:19px;backdrop-filter:blur(18px);box-shadow:0 12px 40px #0002}
.hero{display:grid;grid-template-columns:1.3fr .8fr;gap:16px;margin-bottom:16px}
.eyebrow{color:var(--accent2);font-size:10px;font-weight:800;letter-spacing:2px;text-transform:uppercase}
.hero h2{font-size:clamp(28px,5vw,43px);line-height:1.1;letter-spacing:-1.5px;margin:12px 0}
.gradient{background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
.muted{color:var(--muted)}.small{font-size:11px;line-height:1.7}
.level-card{padding:18px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,#24204499,#10253799)}
.level-number{font-size:29px;color:#c3b5ff;font-weight:900;margin:7px 0}
.tag,.coin-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:50px;padding:7px 10px;background:#a18aff15;font-size:10px;font-weight:700}
.track{height:8px;border-radius:50px;background:#ffffff12;overflow:hidden;margin:13px 0 9px}
.fill{height:100%;width:0;border-radius:50px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .35s}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
.stat{background:#111421bd;border:1px solid var(--line);border-radius:16px;padding:15px}
.stat-icon{font-size:20px}.stat-num{font-size:25px;font-weight:900;margin:8px 0 3px}.stat-label{font-size:10px;color:var(--muted)}
.main{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;align-items:start}
.heading{margin-bottom:16px}
.heading h3{margin:0;font-size:15px}.heading p{font-size:10px;color:var(--muted);margin:5px 0 0}
.field{width:100%;min-width:0;padding:12px;border:1px solid #ffffff16;border-radius:11px;background:#090c15;color:white;outline:none}
.field:focus{border-color:var(--accent)}.field::placeholder{color:#6d718d}
.form-grid,.form-bottom,.search-row{display:grid;grid-template-columns:1fr 125px;gap:9px}
.form-bottom{margin-top:9px}.search-row{margin:16px 0 12px}
.btn{border:1px solid var(--line);border-radius:11px;padding:11px 13px;background:#ffffff09;color:white;font-size:11px;font-weight:700;transition:.2s}
.btn:hover{filter:brightness(1.2);transform:translateY(-1px)}
.primary{border:0;background:linear-gradient(110deg,var(--accent),#527dff);box-shadow:0 7px 25px #7257ff2b}
.green{color:var(--green);background:#62f5b01a}.danger{color:#ff8995}
.task-list,.stack,.achievements{display:grid;gap:9px}
.task{display:grid;grid-template-columns:23px 1fr auto;gap:9px;align-items:center;padding:12px;border:1px solid #ffffff10;border-radius:13px;background:#090c15b5}
.task.done{opacity:.55}.task.done .task-name{text-decoration:line-through}
.check{width:22px;height:22px;border-radius:7px;background:transparent;color:#07120d;border:1px solid #777b9d;padding:0}
.task.done .check{background:var(--green);border-color:var(--green)}
.task-name{font-size:12px;font-weight:700;overflow-wrap:anywhere}
.task-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}
.task-meta span{font-size:9px;color:var(--muted)}
.priority{border-radius:30px;padding:4px 7px;font-size:9px!important;font-weight:800}
.priority-alta{background:#ff63721c;color:#ff8995!important}
.priority-media{background:#ffc65a1b;color:#ffd37a!important}
.priority-baja{background:#62f5b01a;color:#62f5b0!important}
.actions{display:flex;gap:5px}
.icon-btn{width:28px;height:28px;border:1px solid #ffffff12;border-radius:8px;color:#bfc3df;background:#ffffff08}
.empty{padding:25px 12px;text-align:center;border:1px dashed #ffffff20;border-radius:13px;color:var(--muted);font-size:12px;line-height:1.8}
.timer{text-align:center;padding:8px 0}
.circle{width:166px;height:166px;border-radius:50%;margin:14px auto 18px;display:grid;place-items:center;background:radial-gradient(circle,#101321 61%,transparent 62%),conic-gradient(var(--accent) var(--angle,0deg),#ffffff12 0);box-shadow:0 0 35px #8b6bff18}
#timerDisplay{font-size:35px;font-weight:900}
.controls{display:flex;justify-content:center;flex-wrap:wrap;gap:7px}
.achievement{display:grid;grid-template-columns:39px 1fr auto;gap:9px;align-items:center;padding:11px;border:1px solid #ffffff10;border-radius:13px;background:#090c15a0}
.achievement.locked{opacity:.48;filter:saturate(.4)}
.achievement-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;background:#a18aff1a;font-size:20px}
.achievement h4{margin:0 0 4px;font-size:11px}.achievement p{margin:0;color:var(--muted);font-size:9px;line-height:1.5}
.reward{font-size:9px;font-weight:800;text-align:right;color:#ffd66b;white-space:nowrap}
.reward-box{padding:13px;margin-top:12px;border:1px solid var(--line);border-radius:13px;background:#a18aff10}
.reward-box strong{color:#c8baff}.reward-box p{font-size:10px;color:var(--muted);line-height:1.6}
.music-options,.theme-options{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.sound-btn,.theme-btn{border:1px solid var(--line);border-radius:12px;background:#ffffff07;color:white;padding:11px 5px;font-size:10px;font-weight:700}
.sound-btn.active,.theme-btn.active{border-color:var(--accent);background:#a18aff20;box-shadow:0 0 16px #8b6bff18}
.music-status{display:flex;align-items:center;gap:9px;margin:13px 0;font-size:11px;color:var(--muted)}
.equalizer{display:flex;gap:3px;align-items:end;height:18px}
.equalizer span{display:block;width:3px;height:5px;border-radius:3px;background:var(--accent2)}
.equalizer.playing span{animation:bars .55s infinite alternate}
.equalizer span:nth-child(2){animation-delay:.15s}.equalizer span:nth-child(3){animation-delay:.3s}.equalizer span:nth-child(4){animation-delay:.1s}
@keyframes bars{to{height:17px}}
input[type=range]{width:100%;accent-color:var(--accent)}
footer{text-align:center;margin-top:25px;color:#666b87;font-size:9px;letter-spacing:1px}
.toast{position:fixed;bottom:19px;left:50%;transform:translate(-50%,25px);background:#20243a;border:1px solid var(--line);border-radius:13px;padding:13px 17px;font-size:11px;box-shadow:0 10px 40px #0008;opacity:0;pointer-events:none;transition:.25s;z-index:20;text-align:center;max-width:calc(100% - 25px)}
.toast.show{opacity:1;transform:translate(-50%,0)}
.focus-mode .main{grid-template-columns:1fr}
.focus-mode .stack .hide-focus{display:none!important}
@media(max-width:760px){.app{padding:16px 11px 35px}.hero,.main{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.panel{padding:15px}.brand h1{font-size:18px}.logo{width:42px;height:42px}}
@media(max-width:380px){.form-grid,.search-row{grid-template-columns:1fr}.task{grid-template-columns:22px 1fr}.actions{grid-column:2}}
</style>
</head>
<body>
<canvas id="particles"></canvas>
<div class="glow one"></div><div class="glow two"></div><div class="glow three"></div>

<div class="app">
<header>
  <div class="brand"><div class="logo">D10</div><div><h1>FOCUS ULTRA</h1><p>YOUR PERSONAL PRODUCTIVITY SYSTEM</p></div></div>
  <div class="header-right"><div id="clock">00:00:00</div><div id="dateText"></div></div>
</header>

<section class="hero">
  <div class="panel">
    <div class="eyebrow">✦ Tu próxima versión empieza hoy</div>
    <h2>Menos excusas.<br><span class="gradient">Más resultados.</span></h2>
    <p class="muted small">Organizá tus tareas, escuchá sonidos ambientales, ganá experiencia y desbloqueá recompensas.</p>
    <button class="btn primary" onclick="document.getElementById('taskInput').focus()">＋ Crear tarea</button>
    <button class="btn" id="focusBtn">◉ Modo enfoque</button>
  </div>
  <div class="level-card">
    <div class="level-top"><div><div class="eyebrow">Tu progreso</div><div class="level-number">NIVEL <span id="level">1</span></div></div><div class="coin-pill">🪙 <span id="coins">0</span></div></div>
    <div class="track"><div class="fill" id="xpBar"></div></div>
    <div class="level-top small muted"><span id="xpText">0 / 500 XP</span><span id="xpTotal">0 XP total</span></div>
    <p class="small" id="levelMessage"></p>
    <div class="tag">🎖️ <span id="playerTitle">Principiante</span></div>
  </div>
</section>

<section class="stats">
  <div class="stat"><div class="stat-icon">✅</div><div class="stat-num" id="doneCount">0</div><div class="stat-label">Completadas</div></div>
  <div class="stat"><div class="stat-icon">📌</div><div class="stat-num" id="pendingCount">0</div><div class="stat-label">Pendientes</div></div>
  <div class="stat"><div class="stat-icon">🔥</div><div class="stat-num" id="streakCount">0</div><div class="stat-label">Días de racha</div></div>
  <div class="stat"><div class="stat-icon">🏆</div><div class="stat-num" id="achievementCount">0/6</div><div class="stat-label">Logros</div></div>
</section>

<main class="main">
<section class="panel">
  <div class="heading"><div><h3>📋 Mis tareas</h3><p>Un paso a la vez.</p></div><span class="tag" id="taskCounter">0 tareas</span></div>
  <form id="taskForm">
    <div class="form-grid"><input class="field" id="taskInput" placeholder="¿Qué querés lograr hoy?" maxlength="120" required><input class="field" id="taskTime" type="time" aria-label="Hora"></div>
    <div class="form-bottom"><select class="field" id="taskPriority"><option value="media">Prioridad media</option><option value="alta">🔴 Prioridad alta</option><option value="baja">🟢 Prioridad baja</option></select><button class="btn primary" id="submitTask">＋ Agregar tarea</button></div>
  </form>
  <div class="search-row"><input class="field" id="searchInput" placeholder="🔎 Buscar tarea"><select class="field" id="filterSelect"><option value="todas">Todas</option><option value="pendientes">Pendientes</option><option value="hechas">Completadas</option><option value="alta">Prioridad alta</option></select></div>
  <div class="task-list" id="taskList"></div>
  <div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:13px"><button class="btn green" id="completeAll">✓ Completar pendientes</button><button class="btn danger" id="clearDone">Limpiar completadas</button></div>
</section>

<div class="stack">
<section class="panel">
  <div class="heading"><div><h3>🎧 Música para concentrarse</h3><p>Sonidos generados en tu navegador.</p></div></div>
  <div class="music-options">
    <button class="sound-btn active" data-sound="rain">🌧️ Lluvia</button>
    <button class="sound-btn" data-sound="space">🌌 Espacial</button>
    <button class="sound-btn" data-sound="calm">🌊 Relajante</button>
  </div>
  <div class="music-status"><div class="equalizer" id="equalizer"><span></span><span></span><span></span><span></span></div><span id="musicStatus">Música apagada</span></div>
  <div class="controls"><button class="btn primary" id="musicToggle">▶️ Reproducir</button><button class="btn" id="musicStop">■ Detener</button></div>
  <div style="margin-top:16px"><div class="level-top small"><span class="muted">🔊 Volumen</span><span id="volumeText">35%</span></div><input type="range" id="volume" min="0" max="100" value="35"></div>
  <p class="muted small">La música es ambiental y sintética, no canciones comerciales. Tocá reproducir para activar el audio.</p>
</section>

<section class="panel">
  <div class="heading"><div><h3>🎨 Personalizá tu espacio</h3><p>Elegí el color de tu universo.</p></div></div>
  <div class="theme-options">
    <button class="theme-btn active" data-theme="purple">🟣 Violeta</button>
    <button class="theme-btn" data-theme="blue">🔵 Océano</button>
    <button class="theme-btn" data-theme="green">🟢 Neón</button>
  </div>
</section>

<section class="panel">
  <div class="heading"><div><h3>🍅 Temporizador Pomodoro</h3><p>25 minutos de enfoque y 5 de descanso.</p></div></div>
  <div class="timer">
    <div class="tag" id="timerMode">SESIÓN DE ENFOQUE</div>
    <div class="circle" id="timerCircle"><div id="timerDisplay">25:00</div></div>
    <div class="controls"><button class="btn primary" id="timerStart">▶️ Iniciar</button><button class="btn" id="timerReset">↻ Reiniciar</button><button class="btn" id="timerSwitch">☕ Descanso</button></div>
    <p class="muted small" id="timerMessage">Tu concentración vale oro.</p>
    <button class="btn" id="notifyBtn">🔔 Activar notificaciones</button>
  </div>
</section>

<section class="panel">
  <div class="heading"><div><h3>🏆 Sala de logros</h3><p>Desbloqueá medallas y recompensas.</p></div></div>
  <div class="achievements" id="achievements"></div>
  <div class="reward-box"><div class="eyebrow">🎁 Tu título actual</div><strong id="titleDisplay">Principiante</strong><p id="titleDescription">Todo gran progreso empieza con el primer paso.</p></div>
</section>

<section class="panel">
  <div class="heading"><div><h3>🌟 Misión diaria</h3><p>Completá 3 tareas hoy.</p></div></div>
  <div class="track"><div class="fill" id="dailyBar"></div></div>
  <div class="level-top small"><span class="muted">Progreso del día</span><strong id="dailyText">0/3</strong></div>
  <p class="small muted" id="dailyMessage"></p>
</section>
</div>
</main>
<footer>D10 FOCUS ULTRA · YOUR TIME. YOUR WORLD. YOUR PROGRESS.</footer>
</div>
<div class="toast" id="toast"></div>

<script>
const $=id=>document.getElementById(id);
const KEY="d10_focus_ultra_v1";
const today=()=>{const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")};
const base={tasks:[],xp:0,coins:0,sessions:0,completedDates:[],unlocked:[],theme:"purple"};
function load(){
  try{const d=JSON.parse(localStorage.getItem(KEY));if(d&&typeof d==="object")return {...base,...d,tasks:Array.isArray(d.tasks)?d.tasks:[]}}catch(e){}
  return {...base};
}
let data=load(),editing=null,focusMode=false,toastTimeout;
function save(){try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){}}
function toast(s){$("toast").textContent=s;$("toast").classList.add("show");clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>$("toast").classList.remove("show"),3000)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function completed(){return data.tasks.filter(t=>t.done)}
function level(){return Math.floor(data.xp/500)+1}
function titleFor(n){return n>=15?"Leyenda absoluta":n>=10?"Maestro del enfoque":n>=7?"Estratega":n>=5?"Imparable":n>=3?"En crecimiento":n>=2?"En entrenamiento":"Principiante"}
function titleDesc(t){return ({
"Principiante":"Todo gran progreso empieza con el primer paso.",
"En entrenamiento":"Estás construyendo hábitos que te acercan a tus metas.",
"En crecimiento":"Tu esfuerzo empieza a convertirse en resultados.",
"Imparable":"La constancia ya es parte de tu identidad.",
"Estratega":"Planificás, ejecutás y seguís creciendo.",
"Maestro del enfoque":"Protegés tu tiempo y avanzás con intención.",
"Leyenda absoluta":"Tus hábitos hablan por vos. Seguí brillando."
})[t]||"Cada paso cuenta."}
function streak(){
  const days=[...new Set(data.completedDates||[])].sort().reverse();
  const key=d=>d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
  if(!days.length)return 0;
  const now=new Date(),y=new Date();y.setDate(y.getDate()-1);
  if(days[0]!==key(now)&&days[0]!==key(y))return 0;
  let n=0,d=new Date(days[0]+"T12:00:00");
  for(const day of days){if(day!==key(d))break;n++;d.setDate(d.getDate()-1)}
  return n;
}
const medals=[
{id:"first",icon:"🌱",name:"Primer paso",desc:"Completá tu primera tarea.",xp:50,coins:10,test:()=>completed().length>=1},
{id:"five",icon:"⚡",name:"Imparable",desc:"Completá 5 tareas.",xp:100,coins:25,test:()=>completed().length>=5},
{id:"ten",icon:"💎",name:"Máquina de objetivos",desc:"Completá 10 tareas.",xp:200,coins:50,test:()=>completed().length>=10},
{id:"level3",icon:"🚀",name:"Subiendo de nivel",desc:"Alcanzá el nivel 3.",xp:150,coins:35,test:()=>level()>=3},
{id:"session",icon:"🍅",name:"Mente enfocada",desc:"Terminá una sesión Pomodoro.",xp:100,coins:25,test:()=>data.sessions>=1},
{id:"streak",icon:"🔥",name:"Constancia total",desc:"Conseguí una racha de 3 días.",xp:250,coins:75,test:()=>streak()>=3}
];
function checkMedals(){
  for(const m of medals){
    if(!data.unlocked.includes(m.id)&&m.test()){
      data.unlocked.push(m.id);data.xp+=m.xp;data.coins+=m.coins;
      toast("🏆 "+m.name+" desbloqueado: +"+m.xp+" XP y +"+m.coins+" monedas");
    }
  }
}
function renderMedals(){
  $("achievements").innerHTML="";
  medals.forEach(m=>{
    const ok=data.unlocked.includes(m.id),el=document.createElement("div");
    el.className="achievement"+(ok?"":" locked");
    el.innerHTML=`<div class="achievement-icon">${m.icon}</div><div><h4>${ok?"✓ ":"🔒 "}${m.name}</h4><p>${m.desc}</p></div><div class="reward">${ok?"OBTENIDO":"+"+m.xp+" XP"}<br>🪙 ${m.coins}</div>`;
    $("achievements").appendChild(el);
  });
  $("achievementCount").textContent=data.unlocked.length+"/"+medals.length;
}
function summary(){
  const done=completed().length,total=data.tasks.length,n=level(),progress=data.xp%500,title=titleFor(n);
  $("doneCount").textContent=done;$("pendingCount").textContent=total-done;$("streakCount").textContent=streak();
  $("taskCounter").textContent=total+(total===1?" tarea":" tareas");
  $("level").textContent=n;$("coins").textContent=data.coins;
  $("xpText").textContent=progress+" / 500 XP";$("xpTotal").textContent=data.xp+" XP total";
  $("xpBar").style.width=progress/500*100+"%";
  $("levelMessage").textContent="Te faltan "+(500-progress)+" XP para el próximo nivel.";
  $("playerTitle").textContent=title;$("titleDisplay").textContent=title;$("titleDescription").textContent=titleDesc(title);
  const daily=data.tasks.filter(t=>t.done&&t.completedAt===today()).length;
  $("dailyBar").style.width=Math.min(daily,3)/3*100+"%";$("dailyText").textContent=Math.min(daily,3)+"/3";
  $("dailyMessage").textContent=daily>=3?"🎉 ¡Misión diaria completada!":"Completá "+(3-Math.min(daily,3))+" tarea(s) más para cumplir tu misión.";
  renderMedals();
}
function renderTasks(){
  const q=$("searchInput").value.trim().toLowerCase(),f=$("filterSelect").value;
  let arr=[...data.tasks];
  if(q)arr=arr.filter(t=>t.name.toLowerCase().includes(q));
  if(f==="pendientes")arr=arr.filter(t=>!t.done);
  if(f==="hechas")arr=arr.filter(t=>t.done);
  if(f==="alta")arr=arr.filter(t=>t.priority==="alta");
  const pr={alta:0,media:1,baja:2};
  arr.sort((a,b)=>Number(a.done)-Number(b.done)||(pr[a.priority]??1)-(pr[b.priority]??1));
  $("taskList").innerHTML="";
  if(!arr.length){$("taskList").innerHTML='<div class="empty">✨ No hay tareas para mostrar.<br>Agregá una nueva y empezá a avanzar.</div>';return}
  arr.forEach(t=>{
    const el=document.createElement("div");el.className="task"+(t.done?" done":"");
    el.innerHTML=`<button class="check">${t.done?"✓":""}</button><div><div class="task-name">${esc(t.name)}</div><div class="task-meta"><span class="priority priority-${t.priority}">${t.priority.toUpperCase()}</span>${t.time?`<span>🕒 ${esc(t.time)}</span>`:""}<span>${t.done?"✓ Completada":"○ Pendiente"}</span></div></div><div class="actions"><button class="icon-btn edit">✎</button><button class="icon-btn delete">×</button></div>`;
    el.querySelector(".check").onclick=()=>toggleTask(t.id);
    el.querySelector(".edit").onclick=()=>editTask(t.id);
    el.querySelector(".delete").onclick=()=>deleteTask(t.id);
    $("taskList").appendChild(el);
  });
}
function render(){summary();renderTasks();save()}
$("taskForm").addEventListener("submit",e=>{
  e.preventDefault();const name=$("taskInput").value.trim();if(!name)return;
  if(editing!==null){
    const t=data.tasks.find(t=>t.id===editing);
    if(t){t.name=name;t.time=$("taskTime").value;t.priority=$("taskPriority").value}
    editing=null;$("submitTask").textContent="＋ Agregar tarea";toast("✏️ Tarea actualizada");
  }else{
    data.tasks.push({id:Date.now()+Math.random(),name,time:$("taskTime").value,priority:$("taskPriority").value,done:false});
    toast("✨ Tarea agregada");
  }
  $("taskInput").value="";$("taskTime").value="";$("taskPriority").value="media";render();
});
function toggleTask(id){
  const t=data.tasks.find(t=>t.id===id);if(!t)return;
  if(!t.done){
    t.done=true;t.completedAt=today();data.xp+=100;data.coins+=5;
    if(!data.completedDates.includes(today()))data.completedDates.push(today());
    toast("✅ +100 XP y +5 monedas");
  }else{t.done=false;t.completedAt=null;data.xp=Math.max(0,data.xp-100);data.coins=Math.max(0,data.coins-5)}
  checkMedals();render();
}
function editTask(id){
  const t=data.tasks.find(t=>t.id===id);if(!t)return;
  editing=id;$("taskInput").value=t.name;$("taskTime").value=t.time||"";$("taskPriority").value=t.priority;
  $("submitTask").textContent="Guardar cambios";$("taskInput").focus();
  window.scrollTo({top:0,behavior:"smooth"});
}
function deleteTask(id){
  const t=data.tasks.find(t=>t.id===id);if(!t)return;
  if(!confirm("¿Eliminar esta tarea?"))return;
  data.tasks=data.tasks.filter(t=>t.id!==id);render();toast("Tarea eliminada");
}
$("completeAll").onclick=()=>{
  const pending=data.tasks.filter(t=>!t.done);
  if(!pending.length)return toast("No hay tareas pendientes");
  if(!confirm("¿Completar todas las tareas pendientes?"))return;
  pending.forEach(t=>{t.done=true;t.completedAt=today();data.xp+=100;data.coins+=5});
  if(!data.completedDates.includes(today()))data.completedDates.push(today());
  checkMedals();render();toast("🎉 ¡Todas completadas!");
};
$("clearDone").onclick=()=>{
  if(!completed().length)return toast("No hay tareas completadas");
  if(!confirm("¿Eliminar las tareas completadas?"))return;
  data.tasks=data.tasks.filter(t=>!t.done);render();
};
$("searchInput").oninput=renderTasks;$("filterSelect").onchange=renderTasks;
$("focusBtn").onclick=()=>{
  focusMode=!focusMode;document.body.classList.toggle("focus-mode",focusMode);
  $("focusBtn").textContent=focusMode?"✕ Salir del enfoque":"◉ Modo enfoque";
};

/* TEMAS */
const themes={
  purple:["#9b7bff","#59c9ff"],
  blue:["#3b9dff","#55e6ff"],
  green:["#52edb2","#a4ff69"]
};
function setTheme(name){
  if(!themes[name])return;
  data.theme=name;
  document.documentElement.style.setProperty("--accent",themes[name][0]);
  document.documentElement.style.setProperty("--accent2",themes[name][1]);
  document.querySelectorAll(".theme-btn").forEach(b=>b.classList.toggle("active",b.dataset.theme===name));
  save();
}
document.querySelectorAll(".theme-btn").forEach(b=>b.onclick=()=>setTheme(b.dataset.theme));
setTheme(data.theme||"purple");

/* RELOJ */
function clock(){
  const d=new Date();
  $("clock").textContent=d.toLocaleTimeString("es-AR",{hour:"2-digit",minute:"2-digit",second:"2-digit"});
  $("dateText").textContent=d.toLocaleDateString("es-AR",{weekday:"long",day:"numeric",month:"long"});
}
clock();setInterval(clock,1000);

/* AUDIO: LLUVIA, ESPACIAL Y AMBIENTE RELAJANTE */
let audio=null,master=null,noiseSource=null,musicNodes=[],musicPlaying=false,currentSound="rain";
function audioInit(){
  const AC=window.AudioContext||window.webkitAudioContext;
  if(!AC){toast("Tu navegador no admite audio Web Audio");return false}
  if(!audio){
    audio=new AC();master=audio.createGain();master.gain.value=Number($("volume").value)/100;master.connect(audio.destination);
  }
  if(audio.state==="suspended")audio.resume();
  return true;
}
function clearMusic(){
  musicNodes.forEach(n=>{try{n.stop?n.stop():null}catch(e){}try{n.disconnect()}catch(e){}});
  musicNodes=[];
  if(noiseSource){try{noiseSource.stop()}catch(e){}try{noiseSource.disconnect()}catch(e){}noiseSource=null}
}
function makeNoise(type,volume,frequency){
  const buffer=audio.createBuffer(1,audio.sampleRate*3,audio.sampleRate);
  const channel=buffer.getChannelData(0);
  for(let i=0;i<channel.length;i++)channel[i]=(Math.random()*2-1)*(type==="rain"?0.55:0.35);
  const src=audio.createBufferSource();src.buffer=buffer;src.loop=true;
  const filter=audio.createBiquadFilter();filter.type="lowpass";filter.frequency.value=frequency;
  const gain=audio.createGain();gain.gain.value=volume;
  src.connect(filter);filter.connect(gain);gain.connect(master);src.start();
  noiseSource=src;musicNodes.push(filter,gain);
}
function makeDrone(freq,volume,wave="sine"){
  const osc=audio.createOscillator(),gain=audio.createGain();
  osc.type=wave;osc.frequency.value=freq;gain.gain.value=volume;
  osc.connect(gain);gain.connect(master);osc.start();musicNodes.push(osc,gain);
}
function startMusic(){
  if(!audioInit())return;
  clearMusic();
  if(currentSound==="rain"){
    makeNoise("rain",0.24,1400);
    makeNoise("rain",0.10,500);
  }else if(currentSound==="space"){
    makeDrone(55,0.10,"sine");makeDrone(82.4,0.055,"sine");makeDrone(110,0.025,"triangle");
    makeNoise("space",0.025,350);
  }else{
    makeNoise("calm",0.12,650);
    makeDrone(174.61,0.025,"sine");makeDrone(261.63,0.018,"sine");
  }
  musicPlaying=true;updateMusicUI();toast("🎧 Sonido ambiental activado");
}
function stopMusic(){
  clearMusic();musicPlaying=false;updateMusicUI();
}
function updateMusicUI(){
  $("musicToggle").textContent=musicPlaying?"Ⅱ Pausar":"▶️ Reproducir";
  $("musicStatus").textContent=musicPlaying?({rain:"Lluvia relajante activada",space:"Ambiente espacial activado",calm:"Sonido relajante activado"}[currentSound]):"Música apagada";
  $("equalizer").classList.toggle("playing",musicPlaying);
  document.querySelectorAll(".sound-btn").forEach(b=>b.classList.toggle("active",b.dataset.sound===currentSound));
}
document.querySelectorAll(".sound-btn").forEach(b=>b.onclick=()=>{
  currentSound=b.dataset.sound;
  if(musicPlaying)startMusic();else updateMusicUI();
});
$("musicToggle").onclick=()=>musicPlaying?stopMusic():startMusic();
$("musicStop").onclick=()=>{stopMusic();toast("Audio detenido")};
$("volume").oninput=()=>{
  $("volumeText").textContent=$("volume").value+"%";
  if(master&&audio)master.gain.setTargetAtTime(Number($("volume").value)/100,audio.currentTime,.05);
};

/* ALARMA SONORA */
function playAlarm(){
  if(!audioInit())return;
  [0,0.32,0.64,1.0].forEach((delay,i)=>{
    const osc=audio.createOscillator(),gain=audio.createGain();
    osc.type="sine";osc.frequency.value=i%2===0?880:660;
    const start=audio.currentTime+delay;
    gain.gain.setValueAtTime(.0001,start);
    gain.gain.exponentialRampToValueAtTime(.25,start+.025);
    gain.gain.exponentialRampToValueAtTime(.0001,start+.24);
    osc.connect(gain);gain.connect(audio.destination);osc.start(start);osc.stop(start+.27);
  });
  if(navigator.vibrate)navigator.vibrate([200,100,200,100,350]);
  if("Notification" in window&&Notification.permission==="granted"){
    try{new Notification(isBreak?"☕ Descanso terminado":"🍅 Enfoque terminado",{body:isBreak?"Volvé cuando estés listo.":"¡Bien hecho! Es hora de descansar."})}catch(e){}
  }
}
$("notifyBtn").onclick=async()=>{
  if(!("Notification" in window)){toast("Notificaciones no disponibles en este navegador");return}
  try{
    const p=await Notification.requestPermission();
    toast(p==="granted"?"🔔 Notificaciones activadas":"No se activaron las notificaciones");
  }catch(e){toast("No se pudieron activar")}
};

/* POMODORO */
let timerSeconds=1500,timerRunning=false,isBreak=false,timerInterval=null;
function updateTimer(){
  $("timerDisplay").textContent=String(Math.floor(timerSeconds/60)).padStart(2,"0")+":"+String(timerSeconds%60).padStart(2,"0");
  const total=isBreak?300:1500;
  $("timerCircle").style.setProperty("--angle",((total-timerSeconds)/total*360)+"deg");
  $("timerMode").textContent=isBreak?"MODO DESCANSO":"SESIÓN DE ENFOQUE";
  $("timerMessage").textContent=isBreak?"Respirá, estirá el cuerpo y descansá.":"25 minutos para vos y tus objetivos.";
  $("timerSwitch").textContent=isBreak?"🎯 Enfoque":"☕ Descanso";
}
function stopTimer(){clearInterval(timerInterval);timerInterval=null;timerRunning=false;$("timerStart").textContent="▶️ Continuar"}
$("timerStart").onclick=async()=>{
  if(timerRunning){stopTimer();return}
  audioInit();
  timerRunning=true;$("timerStart").textContent="Ⅱ Pausar";
  timerInterval=setInterval(()=>{
    timerSeconds=Math.max(0,timerSeconds-1);updateTimer();
    if(timerSeconds===0){
      stopTimer();playAlarm();
      if(!isBreak){
        data.sessions++;data.xp+=50;data.coins+=10;checkMedals();
        toast("🍅 ¡Enfoque terminado! +50 XP y +10 monedas");
      }else toast("☀️ Descanso terminado. ¡A seguir!");
      isBreak=!isBreak;timerSeconds=isBreak?300:1500;updateTimer();render();
    }
  },1000);
};
$("timerReset").onclick=()=>{stopTimer();timerSeconds=isBreak?300:1500;updateTimer();toast("Temporizador reiniciado")};
$("timerSwitch").onclick=()=>{stopTimer();isBreak=!isBreak;timerSeconds=isBreak?300:1500;updateTimer();toast(isBreak?"Descanso listo":"Enfoque listo")};

/* FONDO ANIMADO */
const canvas=$("particles"),ctx=canvas.getContext("2d");let particles=[];
function resizeCanvas(){
  const scale=Math.min(devicePixelRatio||1,2);
  canvas.width=innerWidth*scale;canvas.height=innerHeight*scale;
  canvas.style.width=innerWidth+"px";canvas.style.height=innerHeight+"px";
  ctx.setTransform(scale,0,0,scale,0,0);particles=[];
  for(let i=0;i<Math.min(75,Math.floor(innerWidth/12));i++)particles.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35,r:Math.random()*1.6+.5});
}
function animate(){
  ctx.clearRect(0,0,innerWidth,innerHeight);
  particles.forEach((p,i)=>{
    p.x+=p.vx;p.y+=p.vy;
    if(p.x<0||p.x>innerWidth)p.vx*=-1;
    if(p.y<0||p.y>innerHeight)p.vy*=-1;
    ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue("--accent2");ctx.fill();
    for(let j=i+1;j<particles.length;j++){
      const q=particles[j],dx=p.x-q.x,dy=p.y-q.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<100){ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.strokeStyle="rgba(130,140,255,"+(.12*(1-d/100))+")";ctx.stroke()}
    }
  });
  requestAnimationFrame(animate);
}
window.addEventListener("resize",resizeCanvas);
resizeCanvas();animate();

/* INICIO */
checkMedals();render();updateTimer();updateMusicUI();
</script>
